<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <!-- CA1707: underscores in test names; CA1848/CA1873: LoggerMessage everywhere is noise for this codebase -->
    <NoWarn>$(NoWarn);CA1848;CA1873;CA2007;CA1716;CA1062;CA1031;CA1724;CA1515;CA1711;CA1308;CA1056;CA1054;CA1055;CA2227;CA1002;CA1819;CA1305;CA1304;CA1311;CA1725;CA1862;CA1826;CA1859</NoWarn>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <Deterministic>true</Deterministic>
    <InvariantGlobalization>false</InvariantGlobalization>
    <Company>BlueMail</Company>
    <Product>BlueMail Business Email</Product>
  </PropertyGroup>
  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('Tests'))">
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);CA1707;CA2201;CA1861;CA1001;CA2000</NoWarn>
  </PropertyGroup>
</Project>
