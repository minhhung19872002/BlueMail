@page "/account/2fa"
@model BlueMail.Identity.Pages.Account.TwoFactorSetupModel
@{
    ViewData["Title"] = L["id.2fa.setup.title"];
}
<h1 id="page-title">@L["id.2fa.setup.title"]</h1>
@if (Model.RecoveryCodes is { } codes)
{
    <p>@L["id.2fa.setup.done"]</p>
    <ul class="codes">
        @foreach (var c in codes)
        {
            <li>@c</li>
        }
    </ul>
    <p><a href="@Model.ContinueUrl">@L["id.continue"]</a></p>
}
else if (Model.Setup is { } setup)
{
    <p>@L["id.2fa.setup.instructions"]</p>
    <p><a href="@setup.OtpAuthUri">@L["id.2fa.setup.open_app"]</a></p>
    <label>@L["id.2fa.setup.secret"]</label>
    <code class="secret">@setup.SecretBase32</code>
    @if (Model.ErrorKey is not null)
    {
        <div class="error" role="alert">@L[Model.ErrorKey]</div>
    }
    <form method="post">
        <input type="hidden" asp-for="ProtectedSecret" />
        <label for="code">@L["id.field.code"]</label>
        <input id="code" type="text" asp-for="Code" inputmode="numeric" autocomplete="one-time-code" required />
        <button type="submit">@L["id.2fa.setup.submit"]</button>
    </form>
}
