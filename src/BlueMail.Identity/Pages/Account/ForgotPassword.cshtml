@page "/account/forgot-password"
@model BlueMail.Identity.Pages.Account.ForgotPasswordModel
@{
    ViewData["Title"] = L["id.forgot.title"];
}
<h1 id="page-title">@L["id.forgot.title"]</h1>
@if (Model.Sent)
{
    <p role="status">@L["id.forgot.sent"]</p>
    <p><a href="/account/login">@L["id.forgot.back"]</a></p>
}
else
{
    <p>@L["id.forgot.intro"]</p>
    <form method="post">
        <label for="email">@L["id.field.email"]</label>
        <input id="email" type="email" asp-for="Email" autocomplete="username" required autofocus dir="auto" />
        <button type="submit">@L["id.forgot.submit"]</button>
    </form>
    <p><a href="/account/login">@L["id.forgot.back"]</a></p>
}
