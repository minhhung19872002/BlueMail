@page "/account/change-password"
@model BlueMail.Identity.Pages.Account.ChangePasswordModel
@{
    ViewData["Title"] = L["id.password.title"];
}
<h1 id="page-title">@L["id.password.title"]</h1>
<p>@(Model.Forced ? L["id.password.forced"] : L["id.password.subtitle"])</p>
@foreach (var key in Model.ErrorKeys)
{
    <div class="error" role="alert">@L[key]</div>
}
<form method="post">
    <input type="hidden" asp-for="ReturnUrl" />
    <label for="current">@L["id.field.current_password"]</label>
    <input id="current" type="password" asp-for="Current" autocomplete="current-password" required />
    <label for="new">@L["id.field.new_password"]</label>
    <input id="new" type="password" asp-for="New" autocomplete="new-password" required minlength="10" />
    <label for="confirm">@L["id.field.confirm_password"]</label>
    <input id="confirm" type="password" asp-for="Confirm" autocomplete="new-password" required minlength="10" />
    <button type="submit">@L["id.password.submit"]</button>
</form>
