# CoreDNS for the BlueMail dev network only. Serves the three test domains and the
# reverse zone of 10.77.0.0/24. Every other name does not exist (NXDOMAIN), as an unknown domain would on the
# Internet; no Internet access is needed. (SERVFAIL here made SPF/DMARC report temperror for unknown senders.)
bluemail.test {
    file /zones/bluemail.test.db
    log
    errors
}
acme.test {
    file /zones/acme.test.db
    log
    errors
}
doitac.test {
    file /zones/doitac.test.db
    log
    errors
}
0.77.10.in-addr.arpa {
    file /zones/0.77.10.in-addr.arpa.db
    log
    errors
}
. {
    template ANY ANY {
        rcode NXDOMAIN
    }
    log
    errors
}
